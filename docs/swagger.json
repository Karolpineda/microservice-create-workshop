{
    "swagger": "2.0",
    "info": {
        "description": "API de microservicio para gestión de workshops",
        "title": "Workshop API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Retorna un mensaje que indica que el microservicio está en funcionamiento",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Verifica el estado del microservicio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/workshops": {
            "get": {
                "description": "Devuelve una lista JSON con todos los Workshops existentes en la base de datos",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Workshops"
                ],
                "summary": "Obtiene todos los Workshops",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Workshop"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Crea un nuevo workshop y lo guarda en la base de datos",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Workshops"
                ],
                "summary": "Crea un nuevo workshop",
                "parameters": [
                    {
                        "description": "Datos del Workshop",
                        "name": "workshop",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.Workshop"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Workshop"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Workshop": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    }
}